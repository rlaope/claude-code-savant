{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["server.ts", "cli.ts", "types.ts", "providers.ts", "response-cache.ts", "personas.ts", "project-scanner.ts"],
  "exclude": ["public", "dist", "node_modules"]
}
